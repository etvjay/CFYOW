{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cfyow.dev/schemas/manifest.schema.json",
  "title": "Experiment Ledger Manifest",
  "type": "object",
  "required": ["schema_version", "experiment_id", "hypothesis", "scenario", "baselines", "targets"],
  "properties": {
    "schema_version": {"const": "experiment-ledger.manifest.v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "hypothesis": {
      "type": "object",
      "required": ["statement", "falsifier"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "falsifier": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": ["id", "input"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "input": {}
      },
      "additionalProperties": true
    },
    "baselines": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "entrypoint"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "entrypoint": {"type": "string"},
          "version": {"type": "string"},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
